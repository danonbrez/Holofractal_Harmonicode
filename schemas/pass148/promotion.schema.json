    "source_proposition_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "REQUESTED",
        "AUTHORIZED",
        "REJECTED"
      ]
    },
    "target_class": {
      "enum": [
        "CONTROL_PROJECTION",
        "DECLARED_SYSTEM_LAW",
        "DERIVABLE_CONSEQUENCE",
        "UNRESOLVED_EXPRESSION",
        "NARRATIVE_EXTRAPOLATION"
