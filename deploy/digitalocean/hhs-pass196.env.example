# HHS Pass 196 DigitalOcean environment
# Matches the established production checkout and Nginx upstream topology.
HHS_REPOSITORY_ROOT=/opt/hhs/app
HHS_PASS196_STATE_ROOT=/var/lib/hhs/pass196
# Existing provider keys remain optional and governed by their own pass contracts.
# HHS_KIMI_K3_API_KEY=

# Standard browser ingress remains same-origin by default. To authorize a
# separately hosted frontend, provide exact origins (scheme://host[:port]),
# comma-separated. Wildcard origins are rejected when authority-bearing
# credentials are enabled.
# HHS_CORS_ALLOWED_ORIGINS=https://console.example.com,http://127.0.0.1:5173

# Compatibility ingress accepts ordinary raw/text/JSON/form/multipart bodies.
# The default bounded request size is 64 MiB; production may lower or raise it
# up to the hard 256 MiB ceiling without changing canonical runtime authority.
# HHS_STANDARD_INGRESS_MAX_BYTES=67108864
