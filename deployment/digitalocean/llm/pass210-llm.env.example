HHS_KIMI_K3_ENABLED=1
HHS_KIMI_K3_BASE_URL=https://api.moonshot.ai/v1
HHS_KIMI_K3_MODEL=kimi-k3
MOONSHOT_API_KEY=replace-with-secret
HHS_KIMI_K3_REASONING_EFFORT=max
HHS_KIMI_K3_TEMPERATURE=1.0
HHS_KIMI_K3_TOP_P=1.0
HHS_KIMI_K3_MAX_COMPLETION_TOKENS=32768
HHS_KIMI_K3_MAX_TOOL_ROUNDS=8
HHS_KIMI_K3_MAX_TOOL_CALLS_PER_ROUND=32
HHS_KIMI_K3_MAX_PARALLEL_TOOLS=8
HHS_KIMI_K3_TIMEOUT_SECONDS=7200
HHS_LITERT_LM_BASE_URL=http://127.0.0.1:9379/v1
HHS_LITERT_LM_MODEL=gemma-4-E2B-it
HHS_LITERT_LM_BACKEND=cpu
HHS_LITERT_LM_TIMEOUT_SECONDS=300
HHS_LITERT_LM_MAX_OUTPUT_TOKENS=4096
HHS_LITERT_LM_TEMPERATURE=0.2
HHS_LITERT_LM_TOP_P=0.95
HHS_LITERT_LM_TOP_K=40
HHS_LITERT_LM_SEED=72
LITERT_LM_DIR=/var/lib/hhs/litert-lm
HHS_PASS210_OPTIMIZER_DB=/var/lib/hhs/pass210/native_agi_optimizer.sqlite3
HHS_NATIVE_LANGUAGE_REQUIRE_WORD2VEC=1
HHS_PASS210_OPTIMIZER_INTERVAL_SECONDS=5
HHS_PASS210_OPTIMIZER_BATCH_LIMIT=8
