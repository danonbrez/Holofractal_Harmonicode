# HHS Pass 195 — Kimi K3 external content-engine configuration
# Copy these values into the protected environment file used by the HHS
# systemd service. Never commit the real API key.

HHS_KIMI_K3_ENABLED=1
HHS_KIMI_K3_BASE_URL=https://api.moonshot.ai/v1
HHS_KIMI_K3_MODEL=kimi-k3
HHS_KIMI_K3_REASONING_EFFORT=max
HHS_KIMI_K3_MAX_COMPLETION_TOKENS=8192
HHS_KIMI_K3_TIMEOUT_SECONDS=300
HHS_KIMI_K3_MAX_REFERENCE_IMAGES=4
HHS_KIMI_K3_MAX_REFERENCE_IMAGE_BYTES=8388608

# Either variable is accepted. Prefer the HHS-specific name when multiple
# Moonshot applications share the same host.
HHS_KIMI_K3_API_KEY=replace-with-moonshot-secret
# MOONSHOT_API_KEY=replace-with-moonshot-secret
