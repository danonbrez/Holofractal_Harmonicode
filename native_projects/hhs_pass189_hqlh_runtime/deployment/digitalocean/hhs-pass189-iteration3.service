[Unit]
Description=HHS Pass 189 Iteration 3 Device Adapter Authority
After=network-online.target hhs-pass189-iteration2.service
Wants=network-online.target
Requires=hhs-pass189-iteration2.service

[Service]
Type=simple
User=hhs
Group=hhs
WorkingDirectory=/opt/holofractal-harmonicode/native_projects/hhs_pass189_hqlh_runtime
EnvironmentFile=-/etc/hhs/pass189.env
ExecStart=/usr/bin/python3 server/hhs_pass189_iteration3_server.py --host 127.0.0.1 --port 8191
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/hhs-pass189

[Install]
WantedBy=multi-user.target
