{
  "$id": "hhs://schemas/pass148/promotion",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "dependency_set": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "governing_rule": {
      "type": "string"
    },
    "requested_by_identity": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "source_class": {
      "enum": [
        "CONTROL_PROJECTION",
        "DECLARED_SYSTEM_LAW",
        "DERIVABLE_CONSEQUENCE",
        "UNRESOLVED_EXPRESSION",
        "NARRATIVE_EXTRAPOLATION"
      ]
