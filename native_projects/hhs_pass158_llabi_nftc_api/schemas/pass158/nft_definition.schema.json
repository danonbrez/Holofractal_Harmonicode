{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hhs://schemas/pass158/nft-definition/1.0.0",
  "title": "HHS Pass 158 NFT Definition",
  "type": "object",
  "required": [
    "contract_id",
    "schema_version",
    "canonical_name",
    "object_class",
    "constraint_graph",
    "tensor_shape",
    "numeric_policy",
    "operator_policy",
    "authority_root",
    "ancestry"
  ],
  "properties": {
    "contract_id": {"const": "HHS-P158-LLABI-NFTC-API"},
    "schema_version": {"type": "string"},
    "canonical_name": {"type": "string", "minLength": 1},
    "object_class": {"const": "NON_FUNGIBLE_TENSOR_CONSTRAINT"},
    "constraint_graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array"},
        "edges": {"type": "array"},
        "equality_chains": {"type": "array"},
        "domain_guards": {"type": "array"},
        "phase_guards": {"type": "array"},
        "dependency_edges": {"type": "array"}
      },
      "additionalProperties": true
    },
    "tensor_shape": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "integer", "minimum": 1}
    },
    "numeric_policy": {"const": "EXACT_SYMBOLIC"},
    "operator_policy": {"const": "HHS_TYPED_OPERATORS"},
    "authority_root": {"type": "string", "minLength": 1},
    "ancestry": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
