{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hhs:p152:gfcc:vm81:v1",
  "title": "GFCC VM81 Fractal State",
  "type": "object",
  "required": ["cell_count", "mapping", "inverse_mapping", "cells", "vm81_digest"],
  "properties": {
    "cell_count": {"const": 81},
    "mapping": {"const": "i=9r+c"},
    "inverse_mapping": {"const": "(r,c)=divmod(i,9)"},
    "cells": {
      "type": "array",
      "minItems": 81,
      "maxItems": 81,
      "items": {
        "type": "object",
        "required": [
          "cell_index", "row", "column", "nonary_residue", "phase_lane",
          "scale_depth", "parent_cell", "child_mask", "symbol", "exact_state",
          "dependency", "constraints", "hash72_projection", "hash216_index"
        ],
        "properties": {
          "cell_index": {"type": "integer", "minimum": 0, "maximum": 80},
          "row": {"type": "integer", "minimum": 0, "maximum": 8},
          "column": {"type": "integer", "minimum": 0, "maximum": 8},
          "nonary_residue": {"type": "integer", "minimum": 0, "maximum": 8},
          "phase_lane": {"type": "integer", "minimum": 0, "maximum": 2},
          "scale_depth": {"type": "integer", "minimum": 0},
          "parent_cell": {"type": "integer"},
          "child_mask": {"type": "integer", "minimum": 0},
          "symbol": {"type": "string"},
          "exact_state": {"$ref": "#/$defs/ratio"},
          "dependency": {"type": "string"},
          "constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "hash72_projection": {"type": ["string", "null"]},
          "hash216_index": {"type": ["string", "null"]}
        }
      }
    },
    "vm81_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "ratio": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
