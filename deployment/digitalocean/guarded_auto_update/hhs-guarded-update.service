[Unit]
Description=HHS guarded repository update, validation, promotion, and rollback
Documentation=https://github.com/danonbrez/Holofractal_Harmonicode
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/hhs/guarded-update.env

[Service]
Type=oneshot
User=root
Group=root
Environment=HHS_NATIVE_LANGUAGE_REQUIRE_WORD2VEC=0
Environment=HHS_PRODUCTION_LANGUAGE_STATUS_PATH=/var/lib/hhs/runtime-bootstrap/production_language_assets_status.json
EnvironmentFile=/etc/hhs/guarded-update.env
ExecStart=/usr/local/lib/hhs-guarded-update/hhs-guarded-update.sh
TimeoutStartSec=90min

# Production availability membrane: candidate validation, large repository-index
# hydration, and native compilation must remain subordinate to sshd/nginx and the
# already-serving HHS runtime on the 2-vCPU/4-GiB production host.
Nice=15
CPUAccounting=true
CPUQuota=100%
CPUWeight=10
MemoryAccounting=true
MemoryHigh=2G
MemoryMax=3G
MemorySwapMax=1G
IOAccounting=true
IOWeight=10
IOSchedulingClass=idle
OOMScoreAdjust=500
TasksMax=512

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
