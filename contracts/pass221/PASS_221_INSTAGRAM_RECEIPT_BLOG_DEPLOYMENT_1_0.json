    "docs/pass221/PASS_221_INSTAGRAM_RECEIPT_BLOG_DEPLOYMENT.md",
    "docs/operations/restart/PASS_221_INSTAGRAM_RECEIPT_BLOG_DEPLOYMENT_RESTART.md",
