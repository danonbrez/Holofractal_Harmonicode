[Unit]
Description=HHS Pass 190 Iteration 7 Durable Worker
After=network-online.target hhs-pass190.service
Wants=network-online.target
Requires=hhs-pass190.service

[Service]
Type=simple
User=hhs
Group=hhs
WorkingDirectory=/opt/hhs/pass190-operation-fabric
EnvironmentFile=/etc/hhs/pass190.env
Environment=PYTHONPATH=/opt/hhs/pass190-operation-fabric/python:/opt/hhs/pass190-operation-fabric/server:/opt/hhs/pass190-operation-fabric/worker
ExecStart=/usr/bin/python3 worker/hhs_pass190_iteration7_worker.py --database /var/lib/hhs/pass190-authority.sqlite3 --worker-id hhs-worker-%H --labels local,digitalocean --poll-ms 250
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/hhs

[Install]
WantedBy=multi-user.target
