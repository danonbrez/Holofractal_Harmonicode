[Unit]
Description=Check the HHS main branch for guarded production updates

[Timer]
# Push-triggered exact-main delivery remains the primary path. This timer is a
# recovery/watchdog follower and must not repeatedly contend with host startup.
OnBootSec=15min
OnUnitActiveSec=30min
RandomizedDelaySec=2min
AccuracySec=30s
Persistent=true
Unit=hhs-guarded-update.service

[Install]
WantedBy=timers.target
