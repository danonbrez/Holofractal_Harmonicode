# Pass 218 Iteration 11 Runtime-OS distributed authority template.
# Copy to a root-readable deployment environment file and replace every example
# hostname/path with the actual three-or-more odd-member production cluster.

HHS_PASS218_DISTRIBUTED_REQUIRED=1
HHS_PASS218_OPERATIONAL_HARDENING_REQUIRED=1
HHS_PASS218_STATE_ROOT=/var/lib/hhs/pass218
HHS_PASS218_ETCD_CLUSTER_NAME=hhs-pass218-production
HHS_PASS218_ETCD_NAMESPACE=/hhs/pass218/production
HHS_PASS218_ETCD_ENDPOINTS=https://etcd-a.internal:2379,https://etcd-b.internal:2379,https://etcd-c.internal:2379
HHS_PASS218_ETCD_CA_FILE=/etc/hhs/pass218-pki/ca.pem
HHS_PASS218_ETCD_CLIENT_CERT_FILE=/etc/hhs/pass218-pki/runtime-client.pem
HHS_PASS218_ETCD_CLIENT_KEY_FILE=/etc/hhs/pass218-pki/runtime-client-key.pem
HHS_PASS218_ETCD_LEASE_TTL_SECONDS=30
HHS_PASS218_ETCD_TIMEOUT_SECONDS=3

# Do not configure HHS_PASS218_ETCD_ENDPOINT at the same time as the multi-member
# HHS_PASS218_ETCD_ENDPOINTS surface. Iteration 11 is selected by ENDPOINTS.
