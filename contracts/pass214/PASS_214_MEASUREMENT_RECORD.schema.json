{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HHS_PASS_214_MEASUREMENT_RECORD.schema.json",
  "title": "HHS Pass 214 Operating Compression Measurement Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_version",
    "workload_class",
    "state_id",
    "transition_id",
    "timestamp_boundary",
    "selected_tier",
    "canonical_state_bytes",
    "encoded_payload_bytes",
    "protected_physical_bytes",
    "metadata_bytes",
    "parity_bytes",
    "exception_count",
    "exception_density_numerator",
    "exception_density_denominator",
    "nearest_predecessor_distance",
    "immediate_predecessor_distance",
    "encode_time_ns",
    "decode_time_ns",
    "recovery_time_ns",
    "dwell_time_ns",
    "state_hash216",
    "package_hash216",
    "hash72_receipt",
    "generator_witness_valid",
    "exact_decode_verified",
    "deterministic_replay_verified",
    "recovery_drill"
  ],
  "properties": {
    "schema": {"const": "HHS_PASS_214_MEASUREMENT_RECORD_V1"},
    "policy_version": {"type": "string", "minLength": 1},
    "workload_class": {"type": "string", "minLength": 1},
    "state_id": {"type": "string", "minLength": 1},
    "transition_id": {"type": ["string", "null"]},
    "timestamp_boundary": {"type": "string", "minLength": 1},
    "selected_tier": {"type": "integer", "enum": [1, 2, 3]},
    "canonical_state_bytes": {"type": "integer", "minimum": 0},
    "encoded_payload_bytes": {"type": "integer", "minimum": 0},
    "protected_physical_bytes": {"type": "integer", "minimum": 0},
    "metadata_bytes": {"type": "integer", "minimum": 0},
    "parity_bytes": {"type": "integer", "minimum": 0},
    "exception_count": {"type": "integer", "minimum": 0},
    "exception_density_numerator": {"type": "integer", "minimum": 0},
    "exception_density_denominator": {"const": 50388480},
    "nearest_predecessor_distance": {"type": ["integer", "null"], "minimum": 0},
    "immediate_predecessor_distance": {"type": ["integer", "null"], "minimum": 0},
    "encode_time_ns": {"type": "integer", "minimum": 0},
    "decode_time_ns": {"type": "integer", "minimum": 0},
    "recovery_time_ns": {"type": "integer", "minimum": 0},
    "dwell_time_ns": {"type": "integer", "minimum": 0},
    "state_hash216": {"type": "string", "minLength": 1},
    "package_hash216": {"type": "string", "minLength": 1},
    "hash72_receipt": {"type": "string", "minLength": 1},
    "generator_witness_valid": {"type": "boolean"},
    "exact_decode_verified": {"const": true},
    "deterministic_replay_verified": {"const": true},
    "recovery_drill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["erasure_count", "within_declared_budget", "outcome"],
      "properties": {
        "erasure_count": {"type": "integer", "minimum": 0},
        "within_declared_budget": {"type": "boolean"},
        "outcome": {"type": "string", "enum": ["NOT_RUN", "RECOVERED_EXACTLY", "FAILED_CLOSED"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"selected_tier": {"const": 1}}},
      "then": {"properties": {"generator_witness_valid": {"const": true}, "exception_count": {"const": 0}}}
    },
    {
      "if": {"properties": {"selected_tier": {"const": 2}}},
      "then": {"properties": {"generator_witness_valid": {"const": true}, "exception_count": {"minimum": 1}}}
    }
  ]
}
