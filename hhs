#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

case "${1:-}" in
  install|probe|plan|status|doctor)
    exec python3 -m hhs_installer.cli "$@"
    ;;
  verify|repair|update|rollback|uninstall|profile|provider|model|environment|receipt|replay-install)
    # These command names are reserved by Pass 172. Unsupported operations
    # terminate explicitly through the canonical installer schema rather than
    # falling through to a parallel authority.
    exec python3 -m hhs_installer.cli "$@"
    ;;
  pass174)
    shift
    exec python3 -m hhs_runtime.pass174.cli "$@"
    ;;
  *)
    exec python3 -m hhs_runtime.pass148.cli "$@"
    ;;
esac
