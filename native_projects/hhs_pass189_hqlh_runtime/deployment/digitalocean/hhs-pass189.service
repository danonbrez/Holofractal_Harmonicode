[Unit]
Description=HHS Pass 189 HQLH Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hhs
Group=hhs
WorkingDirectory=/opt/holofractal-harmonicode/native_projects/hhs_pass189_hqlh_runtime
EnvironmentFile=-/etc/hhs/pass189.env
ExecStart=/usr/bin/python3 server/hhs_pass189_server.py --host 127.0.0.1 --port 8189
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hhs-pass189

[Install]
WantedBy=multi-user.target
