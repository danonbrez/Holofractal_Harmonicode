[Unit]
Description=HHS Pass 196 Integrated Linux API Tool Server and Visual IDE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hhs
Group=hhs
WorkingDirectory=/opt/hhs/app
EnvironmentFile=-/etc/hhs/pass196.env
Environment=PYTHONUNBUFFERED=1
Environment=HHS_REPOSITORY_ROOT=/opt/hhs/app
Environment=HHS_PASS196_STATE_ROOT=/var/lib/hhs/pass196
ExecStart=/opt/hhs/venv/bin/python -m uvicorn hhs_backend.visual_server:app --host 127.0.0.1 --port 8080 --workers 1
Restart=on-failure
RestartSec=2
TimeoutStartSec=120
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/hhs /opt/hhs/app/.hhs

[Install]
WantedBy=multi-user.target
