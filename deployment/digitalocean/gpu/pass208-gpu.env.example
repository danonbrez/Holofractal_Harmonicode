# Pass 208 DigitalOcean physical-GPU runtime
HHS_PASS208_GPU_ENABLED=1
HHS_PASS207_GPU_BACKEND=OPENCL
HHS_PASS207_REQUIRE_PHYSICAL_GPU=1
HHS_PASS207_GPU_DEVICE_INDEX=0
HHS_PASS208_MAX_BRANCHES=256
HHS_PASS207_CACHE_BYTES=536870912
HHS_PASS207_CACHE_ENTRIES=512
HHS_DISABLE_PASS207_C_AUTOBUILD=1
HHS_PASS208_STATE_ROOT=/var/lib/hhs/pass208
HHS_PASS208_PREFLIGHT_RECEIPT=/var/lib/hhs/pass208/PASS208_GPU_PREFLIGHT_RECEIPT.json
HHS_PASS208_SPEC_RECEIPT=/var/lib/hhs/pass208/PASS208_JSON_SPEC_VALIDATION_RECEIPT.json
HHS_JSON_SPEC_PACKAGE_ROOT=/opt/hhs/app/specifications/hhs-runtime-json-package
HHS_JSON_SPEC_MANIFEST=
HHS_JSON_SPEC_EXPECTED_FILES=23
HHS_JSON_SPEC_EXPECTED_EXAMPLES=4
