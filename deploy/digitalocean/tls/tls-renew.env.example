# Installed as /etc/hhs/tls-renew.env by install.sh when absent.
HHS_TLS_HOST=137.184.223.84
HHS_TLS_PORT=443
HHS_TLS_RENEW_BEFORE_DAYS=14
HHS_TLS_MINIMUM_VALID_DAYS=2

# Override these only when the host uses a different certificate authority or
# reverse proxy. The commands execute as root from the systemd service.
HHS_TLS_RENEW_COMMAND="/usr/bin/certbot renew --quiet"
HHS_TLS_RELOAD_COMMAND="/usr/bin/systemctl reload nginx"
